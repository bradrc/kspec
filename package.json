{
  "name": "@acaldas12/kspec",
  "version": "1.0.17",
  "description": "KSpec SDD OS — Scaffold e Interface Visual de Spec-Driven Development (SDD) com Harness Master e integração a CLIs de IA (Claude Code, Gemini CLI, Codex, Cursor).",
  "type": "module",
  "bin": {
    "kspec": "bin/cli.mjs",
    "spec-driven": "bin/cli.mjs"
  },
  "files": [
    "bin",
    "src",
    "template",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "sdd",
    "spec-driven-development",
    "ddd",
    "lean-inception",
    "claude-code",
    "claude",
    "codex",
    "agents-md",
    "cursor",
    "copilot",
    "gemini",
    "windsurf",
    "scaffold",
    "boilerplate",
    "agent-skills"
  ],
  "author": "igoruehara",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bradrc/kspec.git"
  },
  "bugs": {
    "url": "https://github.com/bradrc/kspec/issues"
  },
  "homepage": "https://github.com/bradrc/kspec#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "ui": "node bin/cli.mjs ui",
    "dev": "node bin/cli.mjs ui",
    "pack:check": "npm pack --dry-run",
    "test:scaffold": "node bin/cli.mjs .tmp-scaffold-test --all --force --yes && rm -rf .tmp-scaffold-test",
    "prepublishOnly": "node bin/cli.mjs .tmp-scaffold-test --all --force --yes && rm -rf .tmp-scaffold-test"
  }
}
